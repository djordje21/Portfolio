---
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Hero from '../../components/Hero.astro';
import Numbers from '../../components/Numbers.astro';
import Palette from '../../components/Palette.astro';
import PreopeningTeaser from '../../components/PreopeningTeaser.astro';
import Career from '../../components/Career.astro';
import Costing from '../../components/Costing.astro';
import Philosophy from '../../components/Philosophy.astro';
import Gallery from '../../components/Gallery.astro';
import Testimonial from '../../components/Testimonial.astro';
import Contact from '../../components/Contact.astro';
import Intro from '../../components/Intro.astro';
import Marquee from '../../components/Marquee.astro';
import References from '../../components/References.astro';
import Footer from '../../components/Footer.astro';
import { langs, useTranslations, type Lang } from '../../i18n/utils';

export function getStaticPaths() {
  return langs.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);
---
<Base lang={lang} title={t.meta.title} description={t.meta.description} ogAlt={t.meta.ogAlt} intro>
  <div id="top"></div>
  <Intro t={t} />
  <Header lang={lang} t={t} />
  <main id="main">
    <Hero lang={lang} t={t} />
    <Numbers lang={lang} t={t} />
    <References t={t} />
    <Marquee t={t} />
    <Palette t={t} />
    <PreopeningTeaser lang={lang} t={t} />
    <Costing lang={lang} t={t} />
    <Career t={t} />
    <Philosophy t={t} />
    <Testimonial t={t} />
    <Gallery t={t} />
    <Contact lang={lang} t={t} />
  </main>
  <Footer t={t} />
</Base>
