---
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Hero from '../../components/Hero.astro';
import Numbers from '../../components/Numbers.astro';
import Palette from '../../components/Palette.astro';
import Footer from '../../components/Footer.astro';
import { langs, useTranslations, type Lang } from '../../i18n/utils';

export function getStaticPaths() {
  return langs.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);
---
<Base lang={lang} title={t.meta.title} description={t.meta.description} ogAlt={t.meta.ogAlt}>
  <div id="top"></div>
  <Header lang={lang} t={t} />
  <main id="main">
    <Hero lang={lang} t={t} />
    <Numbers lang={lang} t={t} />
    <Palette t={t} />
  </main>
  <Footer t={t} />
</Base>
