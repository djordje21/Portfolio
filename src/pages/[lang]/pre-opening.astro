---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Gantt from '../../components/Gantt.astro';
import { langs, useTranslations, type Lang } from '../../i18n/utils';
import { domainColours, type Domain } from '../../data/domains';
import planningImg from '../../assets/images/palette/preopening.jpg';

export function getStaticPaths() {
  return langs.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);
const c = t.preopening;
const fmtWeek = (w: number) => (w > 0 ? `+${w}` : w === 0 ? '0' : `−${Math.abs(w)}`);
---
<Base lang={lang} title={c.pageTitle} description={c.pageDescription} ogAlt={c.title}>
  <div id="top"></div>
  <Header lang={lang} t={t} />
  <main id="main">
    <!-- Uvod -->
    <section class="relative overflow-hidden pt-32 md:pt-40 pb-16 md:pb-24">
      <div aria-hidden="true" class="pointer-events-none absolute -top-40 right-[-10%] h-[36rem] w-[36rem] rounded-full bg-ice-deep/20 blur-[140px]"></div>
      <div class="container-x relative grid gap-12 lg:grid-cols-12 lg:items-end">
        <div class="lg:col-span-7">
          <a href={`/${lang}/#pre-opening`} class="text-xs tracking-[0.2em] uppercase text-muted hover:text-snow transition-colors">← {c.back}</a>
          <p class="eyebrow mt-10" data-reveal>{c.eyebrow}</p>
          <h1 class="mt-5 text-[clamp(3rem,7vw,6rem)]" data-split="hero">{c.title}</h1>
          <p class="mt-6 max-w-xl text-lg md:text-xl leading-relaxed text-muted" data-reveal style="--reveal-delay:160ms">{c.lead}</p>
        </div>
        <div class="lg:col-span-5" data-reveal style="--reveal-delay:120ms">
          <figure class="relative">
            <div aria-hidden="true" class="absolute -inset-2 md:-inset-3 border border-ice/40 translate-x-2 translate-y-2 md:translate-x-4 md:translate-y-4"></div>
            <Image src={planningImg} alt="" widths={[480, 800]} sizes="(min-width: 1024px) 36vw, 100vw" class="relative w-full h-auto aspect-[4/3] object-cover" loading="eager" />
          </figure>
        </div>
      </div>

      <div class="container-x relative mt-14" data-reveal>
        <dl class="grid gap-px bg-line border-y border-line sm:grid-cols-3">
          {c.meta.map((m, i) => (
            <div class:list={['bg-navy py-5', i > 0 && 'sm:px-6', i === 0 && 'sm:pr-6']}>
              <dt class="text-[0.7rem] tracking-[0.18em] uppercase text-muted">{m.k}</dt>
              <dd class="mt-1 text-snow/90">{m.v}</dd>
            </div>
          ))}
        </dl>
      </div>
    </section>

    <!-- Tok (Gantt) -->
    <section class="pb-24 md:pb-32">
      <div class="container-x">
        <div class="border border-line bg-navy-2/60 p-6 md:p-12" data-reveal>
          <Gantt t={t} />
        </div>
      </div>
    </section>

    <!-- Faze: redosled je stvaran, zato su numerisane -->
    <section class="section border-t border-line" aria-labelledby="phases-title">
      <div class="container-x">
        <h2 id="phases-title" class="text-4xl md:text-6xl" data-split>{c.phasesTitle}</h2>
        <ol class="mt-14 grid gap-px bg-line border border-line sm:grid-cols-2 lg:grid-cols-4">
          {c.phases.map((ph, i) => (
            <li class="bg-navy-2 p-6 md:p-8 flex flex-col" data-reveal style={`--reveal-delay:${(i % 4) * 80}ms`}>
              <div class="flex items-baseline justify-between gap-4">
                <span class="font-display text-4xl text-ice tabular-nums" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
                <span class="text-[0.7rem] tabular-nums tracking-[0.12em] text-muted">{fmtWeek(ph.start)} → {fmtWeek(ph.end)}</span>
              </div>
              <span aria-hidden="true" class="mt-5 block h-0.5 w-10 rounded-full" style={`background:${domainColours[ph.domain as Domain]}`}></span>
              <h3 class="mt-4 text-2xl leading-tight">{ph.label}</h3>
              <ul class="mt-4 space-y-2.5 text-[0.95rem] leading-relaxed text-muted">
                {ph.points.map((pt) => (
                  <li class="flex gap-3">
                    <span aria-hidden="true" class="mt-[0.75em] h-0.5 w-3 shrink-0 rounded-full bg-snow/30"></span>
                    {pt}
                  </li>
                ))}
              </ul>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- Formati -->
    <section class="section border-t border-line" aria-labelledby="formats-title">
      <div class="container-x">
        <h2 id="formats-title" class="text-4xl md:text-5xl" data-split>{c.formatsTitle}</h2>
        <div class="mt-12 grid gap-10 md:grid-cols-3">
          {c.formats.map((f, i) => (
            <div class="border-t border-ice/40 pt-6" data-reveal style={`--reveal-delay:${i * 100}ms`}>
              <h3 class="text-3xl">{f.t}</h3>
              <p class="mt-3 text-lg leading-relaxed text-snow/85">{f.d}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Šta pravim u svakom projektu -->
    <section class="section border-t border-line" aria-labelledby="deliverables-title">
      <div class="container-x grid gap-12 lg:grid-cols-12">
        <h2 id="deliverables-title" class="lg:col-span-4 text-4xl md:text-5xl" data-split>{c.deliverablesTitle}</h2>
        <ul class="lg:col-span-8 grid sm:grid-cols-2 gap-x-10 border-t border-line">
          {c.deliverables.map((d, i) => (
            <li class="flex gap-5 border-b border-line py-5 text-lg text-snow/90" data-reveal style={`--reveal-delay:${(i % 2) * 70}ms`}>
              <span aria-hidden="true" class="mt-[0.8em] h-0.5 w-5 shrink-0 rounded-full bg-ice"></span>
              {d}
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- Poziv -->
    <section class="section border-t border-line">
      <div class="container-x flex flex-col md:flex-row md:items-center justify-between gap-8">
        <p class="font-display text-3xl md:text-5xl max-w-2xl">{c.cta}</p>
        <a href={`/${lang}/#contact`} class="btn btn-primary shrink-0" data-magnetic>{t.hero.ctaContact} →</a>
      </div>
    </section>
  </main>
  <Footer t={t} />
</Base>
