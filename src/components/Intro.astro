---
import type { Dict } from '../i18n/utils';

interface Props {
  t: Dict;
}
const { t } = Astro.props;
const i = t.intro;
---
<!--
  Filmski uvod: kuhinjska porudžbina se "štampa", dobija FIRE pečat, pa se zavese otvaraju.
  Prikazuje se jednom po poseti (sessionStorage), ne prikazuje se bez JS-a ni uz "reduce motion".
-->
<div id="intro" class="fixed inset-0 z-[100] overflow-hidden" aria-label={i.ticket}>
  <div class="intro-curtain intro-top absolute inset-x-0 top-0 h-1/2 bg-navy"></div>
  <div class="intro-curtain intro-bottom absolute inset-x-0 bottom-0 h-1/2 bg-navy"></div>

  <div class="intro-stage absolute inset-0 grid place-items-center grain" aria-hidden="true">
    <div aria-hidden="true" class="intro-glow absolute top-0 left-1/2 -translate-x-1/2 h-[60vh] w-[60vh] rounded-full bg-ice-deep/30 blur-[120px] opacity-0"></div>
    <div class="intro-rail absolute top-[18%] left-1/2 -translate-x-1/2 h-[3px] w-[min(26rem,80vw)] origin-center scale-x-0 bg-gradient-to-r from-transparent via-ice to-transparent"></div>

    <div class="intro-ticket relative w-[min(23rem,80vw)] bg-snow text-navy shadow-[0_40px_80px_-20px_rgba(0,0,0,.8)]">
      <div class="px-6 pt-6 pb-8 md:px-8 md:pt-8 md:pb-10 font-mono text-[0.78rem] md:text-[0.92rem] leading-relaxed">
        <div class="flex justify-between text-[0.7rem] tracking-widest">
          <span>{i.order}</span><span class="intro-clock">--:--</span>
        </div>
        <div class="mt-1 text-[0.7rem] tracking-widest">{i.table}</div>
        <div class="my-3 border-t border-dashed border-navy/50"></div>
        <ul class="space-y-1.5">
          {i.lines.map((l) => <li class="intro-line opacity-0">{l}</li>)}
        </ul>
        <div class="my-3 border-t border-dashed border-navy/50"></div>
        <p class="intro-line opacity-0 text-[0.7rem] italic">{i.note}</p>
      </div>
      <div class="intro-stamp absolute right-4 bottom-10 rotate-[-14deg] border-[3px] border-[#1f4f9a] px-3 py-1 font-sans font-bold text-2xl tracking-[0.18em] text-[#1f4f9a] opacity-0">
        {i.fire}
      </div>
      <div class="ticket-edge absolute -bottom-2 inset-x-0 h-2 bg-snow"></div>
    </div>
    <p class="intro-service absolute font-display italic text-[clamp(4rem,16vw,13rem)] text-snow opacity-0">{i.service}</p>
  </div>

  <button
    type="button"
    class="intro-skip absolute bottom-6 right-6 z-10 text-[0.7rem] tracking-[0.25em] uppercase text-muted hover:text-snow transition-colors px-3 py-2"
  >
    {i.skip} →
  </button>
</div>

<style>
  .font-mono {
    font-family: ui-monospace, 'SF Mono', Menlo, Consolas, 'Liberation Mono', monospace;
  }
  .ticket-edge {
    clip-path: polygon(0 0, 100% 0, 100% 0, 95% 100%, 90% 0, 85% 100%, 80% 0, 75% 100%, 70% 0, 65% 100%, 60% 0, 55% 100%, 50% 0, 45% 100%, 40% 0, 35% 100%, 30% 0, 25% 100%, 20% 0, 15% 100%, 10% 0, 5% 100%, 0 0);
  }
  :global(.no-js) #intro,
  :global(.intro-seen) #intro {
    display: none;
  }
  @media (prefers-reduced-motion: reduce) {
    #intro { display: none; }
  }
  :global(html.intro-active) { overflow: hidden; }
</style>

<script>
  import { gsap } from 'gsap';

  const root = document.getElementById('intro');
  const finish = () => {
    document.documentElement.classList.remove('intro-active');
    document.documentElement.dataset.intro = 'done';
    document.dispatchEvent(new Event('intro:done'));
  };

  if (!root || getComputedStyle(root).display === 'none') {
    finish();
  } else {
    try { sessionStorage.setItem('intro-seen', '1'); } catch {}
    document.documentElement.classList.add('intro-active');

    const clock = root.querySelector('.intro-clock')!;
    clock.textContent = new Date().toLocaleTimeString(document.documentElement.lang, { hour: '2-digit', minute: '2-digit' });

    const tl = gsap.timeline({
      defaults: { ease: 'power3.out' },
      onComplete: () => {
        root.remove();
        finish();
      },
    });

    tl.to('.intro-rail', { scaleX: 1, duration: 0.6, ease: 'power2.inOut' })
      .to('.intro-glow', { opacity: 1, duration: 1.2 }, '<')
      // "štampanje" porudžbine — skokovito, kao termalni štampač
      .fromTo('.intro-ticket', { clipPath: 'inset(0 0 100% 0)', y: -40 }, { clipPath: 'inset(0 0 0% 0)', y: 0, duration: 1.1, ease: 'steps(14)' }, '-=0.2')
      .to('.intro-line', { opacity: 1, duration: 0.05, stagger: 0.11 }, '<0.15')
      .fromTo('.intro-stamp', { opacity: 0, scale: 2.4 }, { opacity: 1, scale: 1, duration: 0.28, ease: 'power4.in' }, '+=0.15')
      .to('.intro-ticket', { x: 4, duration: 0.05, yoyo: true, repeat: 3, ease: 'none' })
      .addLabel('out', '+=0.35')
      .to('.intro-ticket', { y: '-120vh', rotate: -6, duration: 0.8, ease: 'power3.in' }, 'out')
      .to('.intro-rail, .intro-glow', { opacity: 0, duration: 0.4 }, '<0.2')
      .fromTo('.intro-service', { opacity: 0, scale: 0.92, letterSpacing: '0.2em' }, { opacity: 1, scale: 1, letterSpacing: '0em', duration: 0.9, ease: 'expo.out' }, '-=0.35')
      .to('.intro-service', { opacity: 0, scale: 1.08, filter: 'blur(8px)', duration: 0.5, ease: 'power2.in' }, '+=0.15')
      .to('.intro-top', { yPercent: -100, duration: 1, ease: 'expo.inOut' }, '-=0.2')
      .to('.intro-bottom', { yPercent: 100, duration: 1, ease: 'expo.inOut' }, '<')
      .to('.intro-skip', { opacity: 0, duration: 0.3 }, '<')
      // hero kreće malo pre nego što se zavese potpuno otvore
      .add(() => {
        document.documentElement.dataset.intro = 'opening';
        document.dispatchEvent(new Event('intro:done'));
      }, '-=0.75');

    const skip = () => {
      if (tl.time() < tl.labels.out) tl.play('out');
    };
    root.querySelector('.intro-skip')!.addEventListener('click', skip);
    window.addEventListener('keydown', (e) => {
      if (['Escape', 'Enter', ' '].includes(e.key)) skip();
    }, { once: true });
  }
</script>
