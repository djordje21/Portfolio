---
import type { Dict } from '../i18n/utils';

interface Props {
  t: Dict;
}
const { t } = Astro.props;
const p = t.palette;

// Boja svake "tonske karte" — vrednosti su u global.css (@theme)
const colours: Record<string, string> = {
  craft: 'var(--color-chip-copper)',
  ops: 'var(--color-chip-green)',
  safety: 'var(--color-chip-blue)',
  people: 'var(--color-chip-purple)',
  preopening: 'var(--color-chip-charcoal)',
  languages: 'var(--color-chip-gold)',
};
---
<section id="expertise" class="section relative" aria-labelledby="palette-title">
  <div class="container-x">
    <div class="grid gap-8 lg:grid-cols-12 lg:items-end">
      <div class="lg:col-span-7">
        <p class="eyebrow" data-reveal>{p.eyebrow}</p>
        <h2 id="palette-title" class="mt-5 text-5xl md:text-7xl" data-reveal style="--reveal-delay:80ms">{p.title}</h2>
      </div>
      <p class="lg:col-span-5 text-lg leading-relaxed text-muted" data-reveal style="--reveal-delay:160ms">{p.intro}</p>
    </div>

    <div class="mt-14 md:mt-20" data-palette>
      <div role="tablist" aria-label={p.title} data-reveal class="grid grid-cols-3 md:grid-cols-6 gap-3 md:gap-4">
        {p.chips.map((c, i) => (
          <button
            type="button"
            role="tab"
            id={`chip-${c.id}`}
            aria-controls={`panel-${c.id}`}
            aria-selected={i === 0 ? 'true' : 'false'}
            tabindex={i === 0 ? 0 : -1}
            class="chip group relative flex flex-col text-left bg-cream shadow-[0_1px_0_rgba(0,0,0,.4)] transition-transform duration-500 ease-[var(--ease-out-soft)] hover:-translate-y-2 aria-selected:-translate-y-3"
            style={`--chip:${colours[c.id]}`}
          >
            <span class="block aspect-[3/4] md:aspect-[2/3] bg-[var(--chip)] relative overflow-hidden">
              <span aria-hidden="true" class="absolute inset-0 bg-gradient-to-br from-white/10 via-transparent to-black/20"></span>
              <span aria-hidden="true" class="absolute top-2.5 left-2.5 md:top-3 md:left-3 text-[0.6rem] md:text-[0.65rem] tracking-[0.18em] text-white/80 font-medium">{c.code}</span>
            </span>
            <span class="block flex-1 px-2.5 py-3 md:px-3 md:py-4 text-ink">
              <span class="block text-[0.58rem] md:text-[0.62rem] tracking-[0.18em] uppercase text-ink/65">{c.colour}</span>
              <span class="block mt-1 font-display text-base md:text-lg leading-tight font-semibold">{c.name}</span>
            </span>
            <span aria-hidden="true" class="chip-indicator absolute -bottom-3 left-1/2 -translate-x-1/2 h-1 w-0 bg-[var(--chip)] transition-all duration-500"></span>
          </button>
        ))}
      </div>

      <p class="mt-6 text-xs tracking-[0.2em] uppercase text-muted md:hidden" aria-hidden="true">↑ {p.hint}</p>

      <div class="mt-10 md:mt-14">
        {p.chips.map((c, i) => (
          <div
            role="tabpanel"
            id={`panel-${c.id}`}
            aria-labelledby={`chip-${c.id}`}
            tabindex="0"
            hidden={i !== 0}
            class="panel relative grid gap-8 md:grid-cols-12 border border-line bg-ink-2 p-6 md:p-12 overflow-hidden"
            style={`--chip:${colours[c.id]}`}
          >
            <span aria-hidden="true" class="absolute inset-y-0 left-0 w-1.5 bg-[var(--chip)]"></span>
            <span aria-hidden="true" class="absolute -right-24 -top-24 h-72 w-72 rounded-full bg-[var(--chip)] opacity-20 blur-3xl"></span>
            <div class="md:col-span-5 relative">
              <p class="text-[0.7rem] tracking-[0.22em] uppercase text-muted">{c.code} · {c.colour}</p>
              <h3 class="mt-3 text-4xl md:text-5xl">{c.name}</h3>
              <p class="mt-5 text-lg leading-relaxed text-cream/85">{c.summary}</p>
            </div>
            <ul class="md:col-span-7 relative grid gap-px bg-line border border-line self-start">
              {c.points.map((pt) => (
                <li class="bg-ink-2 px-5 py-4 flex gap-4 text-[0.95rem] leading-relaxed text-cream/90">
                  <span aria-hidden="true" class="mt-2.5 h-1.5 w-1.5 shrink-0 bg-[var(--chip)] ring-1 ring-cream/30"></span>
                  {pt}
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .chip[aria-selected='true'] .chip-indicator { width: 60%; }
  .chip[aria-selected='true'] { box-shadow: 0 24px 40px -18px var(--chip); }
  .panel:not([hidden]) { animation: panel-in 0.6s var(--ease-out-soft); }
  @keyframes panel-in {
    from { opacity: 0; transform: translateY(12px); }
    to { opacity: 1; transform: none; }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-palette]').forEach((root) => {
    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('[role="tab"]'));
    const panels = Array.from(root.querySelectorAll<HTMLElement>('[role="tabpanel"]'));

    const select = (idx: number, focus = false) => {
      tabs.forEach((tab, i) => {
        const on = i === idx;
        tab.setAttribute('aria-selected', String(on));
        tab.tabIndex = on ? 0 : -1;
        panels[i].hidden = !on;
      });
      if (focus) tabs[idx].focus();
    };

    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => select(i));
      tab.addEventListener('keydown', (e) => {
        const n = tabs.length;
        const map: Record<string, number> = {
          ArrowRight: (i + 1) % n,
          ArrowDown: (i + 1) % n,
          ArrowLeft: (i - 1 + n) % n,
          ArrowUp: (i - 1 + n) % n,
          Home: 0,
          End: n - 1,
        };
        if (e.key in map) {
          e.preventDefault();
          select(map[e.key], true);
        }
      });
    });

    // Na desktopu (miš) hover takođe otvara detalje, uz malu pauzu da ne treperi
    if (window.matchMedia('(hover: hover) and (pointer: fine)').matches) {
      let timer: number | undefined;
      tabs.forEach((tab, i) => {
        tab.addEventListener('mouseenter', () => {
          clearTimeout(timer);
          timer = window.setTimeout(() => select(i), 180);
        });
        tab.addEventListener('mouseleave', () => clearTimeout(timer));
      });
    }
  });
</script>
