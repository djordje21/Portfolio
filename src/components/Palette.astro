---
import type { Dict } from '../i18n/utils';

interface Props {
  t: Dict;
}
const { t } = Astro.props;
const p = t.palette;
const g = t.game;

import { Image } from 'astro:assets';
import { domainColours } from '../data/domains';
import craftImg from '../assets/images/palette/craft.jpg';
import opsImg from '../assets/images/palette/ops.jpg';
import safetyImg from '../assets/images/palette/safety.jpg';
import peopleImg from '../assets/images/palette/people.jpg';
import preopeningImg from '../assets/images/palette/preopening.jpg';
import suppliersImg from '../assets/images/palette/suppliers.jpg';
import serviceImg from '../assets/images/portrait-kitchen.jpg';

// Boja svake karte — tonovi koji klasično idu uz teget (src/data/domains.ts)
const colours: Record<string, string> = domainColours;
// Svetle boje dobijaju tamna slova, tamne bela (kontrast)
const lightChips = new Set(['ops', 'preopening']);

// Fotografija po kartici. Zameni fajl u src/assets/images/palette/ ili dodaj novu.
// Karte bez fotografije prikazuju tipografski znak.
const photos: Record<string, ImageMetadata | undefined> = {
  craft: craftImg,
  ops: opsImg,
  safety: safetyImg,
  people: peopleImg,
  preopening: preopeningImg,
  suppliers: suppliersImg,
};

// Pozicije "mrlja" na tanjiru (6 mesta u krugu)
const slots = p.chips.map((_, i) => {
  const a = ((-90 + i * 60) * Math.PI) / 180;
  const r = 92;
  return { x: 200 + Math.cos(a) * r, y: 200 + Math.sin(a) * r, rot: -90 + i * 60 + 90 };
});
---
<section id="expertise" class="section relative overflow-hidden" aria-labelledby="palette-title">
  <div class="container-x">
    <div class="grid gap-8 lg:grid-cols-12 lg:items-end">
      <div class="lg:col-span-7">
        <p class="eyebrow" data-reveal>{p.eyebrow}</p>
        <h2 id="palette-title" class="mt-5 text-5xl md:text-7xl" data-split>{p.title}</h2>
      </div>
      <p class="lg:col-span-5 text-lg leading-relaxed text-muted" data-reveal style="--reveal-delay:160ms">{p.intro}</p>
    </div>

    <div class="relative mt-14 md:mt-20" data-game>
      <canvas class="game-sparks pointer-events-none absolute inset-0 z-20 h-full w-full" aria-hidden="true"></canvas>

      <div class="grid grid-cols-[minmax(0,1fr)] gap-6 lg:grid-cols-12 lg:gap-10 items-center">
        <!-- Tonske karte -->
        <div class="min-w-0 lg:col-span-7 order-2 lg:order-1">
          <div class="strip-viewport -mx-5 overflow-hidden lg:mx-0 lg:overflow-visible" data-reveal data-lenis-prevent>
          <div role="tablist" aria-label={p.title} class="chip-strip flex gap-3 px-5 pt-4 pb-6 lg:grid lg:grid-cols-3 lg:gap-5 lg:p-0">
            {p.chips.map((c, i) => (
              <button
                type="button"
                role="tab"
                id={`chip-${c.id}`}
                aria-controls={`panel-${c.id}`}
                aria-selected={i === 0 ? 'true' : 'false'}
                tabindex={i === 0 ? 0 : -1}
                data-index={i}
                data-colour={colours[c.id]}
                data-cursor={g.cursor}
                class="chip group relative flex w-[42vw] max-w-[13rem] shrink-0 snap-start flex-col text-left bg-snow select-none lg:w-auto lg:max-w-none touch-manipulation shadow-[0_1px_0_rgba(0,0,0,.4)] transition-[translate,box-shadow,opacity] duration-500 ease-[var(--ease-out-soft)] hover:-translate-y-2 aria-selected:-translate-y-3"
                style={`--chip:${colours[c.id]}`}
              >
                <span class="chip-swatch block aspect-[4/3] bg-[var(--chip)] relative overflow-hidden">
                  {photos[c.id] ? (
                    <Image
                      src={photos[c.id]!}
                      alt=""
                      widths={[240, 400, 600]}
                      sizes="(min-width: 1024px) 14rem, 30vw"
                      class="chip-photo absolute inset-0 h-full w-full object-cover transition-transform duration-700 group-hover:scale-105"
                    />
                  ) : (
                    <span aria-hidden="true" class:list={['absolute inset-0 grid place-items-center font-display italic text-lg sm:text-xl md:text-2xl lg:text-3xl whitespace-nowrap', lightChips.has(c.id) ? 'text-navy/80' : 'text-white/90']}>{'glyph' in c ? c.glyph : ''}</span>
                  )}
                  <span aria-hidden="true" class="absolute inset-0 bg-gradient-to-b from-black/25 via-transparent to-transparent"></span>
                  <span class="chip-check absolute bottom-2 right-2 md:bottom-3 md:right-3 grid h-6 w-6 place-items-center rounded-full bg-snow text-navy text-xs opacity-0 scale-50 transition-all duration-500" aria-hidden="true">✓</span>
                </span>
                <span class="block flex-1 px-2.5 py-3 md:px-3 md:py-4 text-navy">
                  <span class="block font-display text-base md:text-xl leading-tight font-semibold">{c.name}</span>
                  <span class="chip-plated sr-only">— {g.plated}</span>
                </span>
                <span aria-hidden="true" class="chip-indicator absolute -bottom-3 left-1/2 -translate-x-1/2 h-1 w-0 bg-[var(--chip)] transition-all duration-500"></span>
              </button>
            ))}
          </div>
          </div>
          <!-- telefon: strelice i tačkice za traku sa karticama -->
          <div class="strip-nav flex items-center justify-between gap-4 lg:hidden">
            <button type="button" class="strip-prev grid h-11 w-11 place-items-center rounded-full border border-line text-snow/80 disabled:opacity-30" aria-label={g.prev}>←</button>
            <div class="strip-dots flex gap-2" aria-hidden="true">
              {p.chips.map((_, i) => <span class:list={['h-1.5 rounded-full transition-all duration-300', i === 0 ? 'w-5 bg-ice' : 'w-1.5 bg-snow/25']}></span>)}
            </div>
            <button type="button" class="strip-next grid h-11 w-11 place-items-center rounded-full border border-line text-snow/80 disabled:opacity-30" aria-label={g.next}>→</button>
          </div>
          <p class="mt-4 lg:mt-8 text-xs tracking-[0.2em] uppercase text-muted flex items-center gap-3">
            <span aria-hidden="true" class="inline-block h-px w-8 bg-ice"></span>
            <span class="hint-drag hidden">{g.hintDrag}</span>
            <span class="hint-tap">{g.hintTap}</span>
          </p>
        </div>

        <!-- Tanjir -->
        <div class="lg:col-span-5 order-1 lg:order-2" data-reveal style="--reveal-delay:120ms">
          <div class="plate-wrap relative mx-auto w-[min(48vw,11rem)] sm:w-[min(100%,14rem)] lg:w-[min(100%,26rem)]">
            <svg class="plate block w-full h-auto overflow-visible" viewBox="0 0 400 400" role="img" aria-labelledby="plate-title">
              <title id="plate-title">{g.title}</title>
              <defs>
                <radialGradient id="plate-g" cx="45%" cy="40%" r="65%">
                  <stop offset="0%" stop-color="#ffffff" />
                  <stop offset="70%" stop-color="#eef2f7" />
                  <stop offset="100%" stop-color="#c9d3e0" />
                </radialGradient>
                <radialGradient id="well-g" cx="50%" cy="45%" r="60%">
                  <stop offset="0%" stop-color="#ffffff" />
                  <stop offset="100%" stop-color="#eef2f8" />
                </radialGradient>
                <filter id="plate-shadow" x="-20%" y="-20%" width="140%" height="150%">
                  <feDropShadow dx="0" dy="22" stdDeviation="20" flood-color="#000" flood-opacity="0.65" />
                </filter>
              </defs>
              <g class="plate-body">
                <circle cx="200" cy="200" r="190" fill="url(#plate-g)" filter="url(#plate-shadow)" />
                <circle cx="200" cy="200" r="142" fill="url(#well-g)" stroke="#d5dde8" stroke-width="1.5" />
                <circle class="plate-ring" cx="200" cy="200" r="168" fill="none" stroke="#3f72c4" stroke-width="1" stroke-dasharray="2 6" opacity="0.7" />
                <g class="dabs">
                  {slots.map((s, i) => (
                    <g class="dab" data-slot={i} transform={`translate(${s.x} ${s.y}) rotate(${s.rot})`}>
                      <g class="dab-inner" opacity="0">
                        <ellipse rx="40" ry="17" fill={colours[p.chips[i].id]} />
                        <ellipse rx="40" ry="17" fill="url(#well-g)" opacity="0.12" />
                        <circle cx="34" cy="-20" r="6" fill={colours[p.chips[i].id]} />
                        <circle cx="46" cy="-12" r="3" fill={colours[p.chips[i].id]} />
                      </g>
                    </g>
                  ))}
                </g>
                <g class="plate-center" text-anchor="middle" fill="#0a1628">
                  <text class="plate-count" x="200" y="208" font-family="'Playfair Display Variable', Georgia, serif" font-size="56" font-weight="500">0/6</text>
                  <text class="plate-label" x="200" y="234" font-family="'Inter Variable', system-ui, sans-serif" font-size="10" letter-spacing="3">{g.stations.toUpperCase()}</text>
                  <text class="plate-done" x="200" y="214" font-family="'Playfair Display Variable', Georgia, serif" font-size="58" font-style="italic" font-weight="500" opacity="0">{g.doneTitle}</text>
                </g>
              </g>
            </svg>
          </div>

          <div class="mt-3 lg:mt-6 flex items-center justify-center gap-6 text-[0.7rem] tracking-[0.2em] uppercase">
            <button type="button" class="game-sound text-muted hover:text-snow transition-colors py-2" aria-pressed="true" data-on={g.soundOn} data-off={g.soundOff}>
              ♪ <span>{g.soundOn}</span>
            </button>
            <button type="button" class="game-reset text-muted hover:text-snow transition-colors py-2 invisible">↺ {g.reset}</button>
          </div>
          <p class="game-status sr-only" aria-live="polite"></p>
        </div>
      </div>

      <!-- Završna poruka -->
      <div class="game-done hidden relative mt-12 overflow-hidden border border-line">
        <Image src={serviceImg} alt="" widths={[800, 1400]} sizes="100vw" class="absolute inset-0 h-full w-full object-cover object-[50%_30%] opacity-45" />
        <div aria-hidden="true" class="absolute inset-0 bg-gradient-to-r from-navy via-navy/85 to-navy/30"></div>
        <div class="relative grid gap-10 p-8 md:p-12 lg:grid-cols-12 lg:items-end">
          <div class="lg:col-span-7">
            <p class="eyebrow">{g.title}</p>
            <p class="mt-4 font-display italic text-5xl md:text-7xl text-snow">{g.doneTitle}</p>
            <p class="mt-4 text-lg text-snow/90 max-w-xl">{g.doneText}</p>
            <!-- svetla stanica: svaka oblast se "pali" svojom bojom -->
            <ul class="mt-8 grid grid-cols-3 md:grid-cols-6 gap-3" aria-hidden="true">
              {p.chips.map((c) => (
                <li>
                  <span class="station-light block h-1.5 origin-left" style={`background:${colours[c.id]}`}></span>
                  <span class="mt-2 block text-[0.62rem] leading-tight tracking-[0.12em] uppercase text-snow/75">{c.name}</span>
                </li>
              ))}
            </ul>
          </div>
          <div class="lg:col-span-5 lg:text-right">
            <a href="#contact" class="btn btn-primary" data-magnetic>{g.cta} →</a>
          </div>
        </div>
      </div>

      <!-- Detalji izabrane oblasti (na telefonu: list koji izlazi odozdo) -->
      <div class="sheet-backdrop fixed inset-0 z-[89] bg-navy/70 backdrop-blur-sm opacity-0 pointer-events-none transition-opacity duration-300 lg:hidden" aria-hidden="true"></div>
      <div class="panels mt-12 md:mt-16" data-sheet data-lenis-prevent>
        <div class="sheet-bar sticky top-0 z-10 flex items-center justify-between border-b border-line bg-navy-2 px-5 py-3 lg:hidden">
          <span aria-hidden="true" class="mx-auto h-1 w-10 rounded-full bg-snow/25"></span>
          <button type="button" class="sheet-close absolute right-3 top-1.5 p-2 text-muted hover:text-snow" aria-label={g.close}>✕</button>
        </div>
        {p.chips.map((c, i) => (
          <div
            role="tabpanel"
            id={`panel-${c.id}`}
            aria-labelledby={`chip-${c.id}`}
            tabindex="0"
            hidden={i !== 0}
            class="panel relative grid gap-8 md:grid-cols-12 border border-line bg-navy-2 p-6 md:p-12 overflow-hidden"
            style={`--chip:${colours[c.id]}`}
          >
            <span aria-hidden="true" class="absolute inset-y-0 left-0 w-1.5 bg-[var(--chip)]"></span>
            <span aria-hidden="true" class="absolute -right-24 -top-24 h-72 w-72 rounded-full bg-[var(--chip)] opacity-20 blur-3xl"></span>
            <div class="md:col-span-5 relative">
              <span aria-hidden="true" class="block h-0.5 w-12 bg-[var(--chip)]"></span>
              <h3 class="mt-5 text-4xl md:text-5xl">{c.name}</h3>
              <p class="mt-5 text-lg leading-relaxed text-snow/85">{c.summary}</p>
            </div>
            <ul class="md:col-span-7 relative grid gap-px bg-line border border-line self-start">
              {c.points.map((pt) => (
                <li class="panel-point bg-navy-2 px-5 py-4 flex gap-4 text-[0.95rem] leading-relaxed text-snow/90">
                  <span aria-hidden="true" class="mt-[0.72em] h-0.5 w-4 shrink-0 rounded-full bg-[var(--chip)]"></span>
                  {pt}
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .chip[aria-selected='true'] .chip-indicator { width: 60%; }
  .chip[aria-selected='true'] { box-shadow: 0 24px 40px -18px var(--chip); }
  .chip.is-plated .chip-check { opacity: 1; transform: scale(1); }
  .chip.is-dragging { opacity: 0.35; }
  .panel:not([hidden]) { animation: panel-in 0.6s var(--ease-out-soft); }
  @media (max-width: 1023px) {
    .chip-strip { touch-action: pan-y; will-change: transform; transition: transform 0.45s var(--ease-out-soft); }
    .chip-strip.is-dragging { transition: none; }
  }
  @media (max-width: 1023px) {
    .chip:hover { translate: none; }
    .chip[aria-selected='true'] { translate: 0 -0.5rem; }
    .panels {
      position: fixed; inset-inline: 0; bottom: 0; z-index: 90; margin: 0;
      max-height: 82dvh; overflow-y: auto; overscroll-behavior: contain;
      background: var(--color-navy-2); border-top: 1px solid var(--color-line);
      transform: translateY(105%); transition: transform 0.45s var(--ease-out-soft);
      padding-bottom: env(safe-area-inset-bottom, 0px);
    }
    .panels.is-open { transform: none; box-shadow: 0 -30px 60px -20px rgba(0, 0, 0, 0.6); }
    .panels .panel { border: 0; }
    .sheet-backdrop.is-open { opacity: 1; pointer-events: auto; }
  }
  .plate-wrap.is-over .plate-ring { stroke-width: 3; opacity: 1; }
  .plate-ring { transition: stroke-width 0.3s, opacity 0.3s; }
  :global(.drag-ghost) {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 150;
    pointer-events: none;
    width: 84px;
    height: 64px;
    border-radius: 2px;
    box-shadow: 0 30px 50px -10px rgba(0, 0, 0, 0.7);
  }
  :global(.fly-dot) {
    position: fixed;
    z-index: 150;
    pointer-events: none;
    border-radius: 9999px;
  }
  @keyframes panel-in {
    from { opacity: 0; transform: translateY(12px); }
    to { opacity: 1; transform: none; }
  }
</style>

<script>
  import { gsap } from 'gsap';
  import { createSparks } from '../scripts/sparks';

  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const fine = window.matchMedia('(hover: hover) and (pointer: fine)').matches;

  /* ---------- Zvuk: sintetizovano kuhinjsko zvono (bez audio fajlova) ---------- */
  let audio: AudioContext | null = null;
  let soundOn = true;
  try { soundOn = localStorage.getItem('game-sound') !== 'off'; } catch {}
  const ac = () => (audio ??= new (window.AudioContext || (window as any).webkitAudioContext)());

  function plop(pitch = 1) {
    if (!soundOn) return;
    const a = ac(), t = a.currentTime;
    const o = a.createOscillator(), g = a.createGain();
    o.type = 'sine';
    o.frequency.setValueAtTime(420 * pitch, t);
    o.frequency.exponentialRampToValueAtTime(140 * pitch, t + 0.14);
    g.gain.setValueAtTime(0.0001, t);
    g.gain.exponentialRampToValueAtTime(0.18, t + 0.01);
    g.gain.exponentialRampToValueAtTime(0.0001, t + 0.18);
    o.connect(g).connect(a.destination);
    o.start(t);
    o.stop(t + 0.2);
  }

  function bell() {
    if (!soundOn) return;
    const a = ac(), t = a.currentTime;
    // zvono za "Service!" — osnovni ton + neharmonijski parcijali
    [[1568, 0.22], [1568 * 2.76, 0.08], [1568 * 5.4, 0.04], [1568 * 0.5, 0.05]].forEach(([f, v]) => {
      const o = a.createOscillator(), g = a.createGain();
      o.type = 'sine';
      o.frequency.value = f;
      g.gain.setValueAtTime(0.0001, t);
      g.gain.exponentialRampToValueAtTime(v, t + 0.005);
      g.gain.exponentialRampToValueAtTime(0.0001, t + 2.2);
      o.connect(g).connect(a.destination);
      o.start(t);
      o.stop(t + 2.3);
    });
  }

  document.querySelectorAll<HTMLElement>('[data-game]').forEach((root) => {
    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('[role="tab"]'));
    const panels = Array.from(root.querySelectorAll<HTMLElement>('[role="tabpanel"]'));
    const plateWrap = root.querySelector<HTMLElement>('.plate-wrap')!;
    const plateBody = root.querySelector<SVGGElement>('.plate-body')!;
    const dabs = Array.from(root.querySelectorAll<SVGGElement>('.dab'));
    const count = root.querySelector<SVGTextElement>('.plate-count')!;
    const label = root.querySelector<SVGTextElement>('.plate-label')!;
    const doneText = root.querySelector<SVGTextElement>('.plate-done')!;
    const status = root.querySelector<HTMLElement>('.game-status')!;
    const done = root.querySelector<HTMLElement>('.game-done')!;
    const resetBtn = root.querySelector<HTMLButtonElement>('.game-reset')!;
    const soundBtn = root.querySelector<HTMLButtonElement>('.game-sound')!;
    const canvas = root.querySelector<HTMLCanvasElement>('.game-sparks')!;
    const sparks = reduce ? null : createSparks(canvas, {});
    const plated = new Set<number>();
    let round = 0;
    let completeTimer: number | undefined;
    const total = tabs.length;
    const stationsLabel = label.textContent ?? '';

    if (fine) {
      root.querySelector('.hint-drag')!.classList.remove('hidden');
      root.querySelector('.hint-tap')!.classList.add('hidden');
    }

    /* --- zvuk on/off --- */
    const renderSound = () => {
      soundBtn.setAttribute('aria-pressed', String(soundOn));
      soundBtn.querySelector('span')!.textContent = (soundOn ? soundBtn.dataset.on : soundBtn.dataset.off) ?? '';
      soundBtn.classList.toggle('line-through', !soundOn);
    };
    renderSound();
    soundBtn.addEventListener('click', () => {
      soundOn = !soundOn;
      try { localStorage.setItem('game-sound', soundOn ? 'on' : 'off'); } catch {}
      renderSound();
    });

    /* --- tabovi (detalji oblasti) --- */
    const select = (idx: number, focus = false) => {
      tabs.forEach((tab, i) => {
        const on = i === idx;
        tab.setAttribute('aria-selected', String(on));
        tab.tabIndex = on ? 0 : -1;
        panels[i].hidden = !on;
      });
      if (focus) tabs[idx].focus({ preventScroll: true });
      showTab(idx);
      if (!reduce) gsap.fromTo(panels[idx].querySelectorAll('.panel-point'), { opacity: 0, x: 20 }, { opacity: 1, x: 0, stagger: 0.05, duration: 0.5, ease: 'power3.out', overwrite: true });
    };

    /* --- stavljanje boje na tanjir --- */
    const plateRect = () => plateWrap.getBoundingClientRect();

    const updateCount = () => {
      count.textContent = `${plated.size}/${total}`;
      status.textContent = `${plated.size}/${total} ${stationsLabel.toLowerCase()}`;
      resetBtn.classList.toggle('invisible', plated.size === 0);
    };

    const showDab = (i: number) => {
      const inner = dabs[i].querySelector<SVGGElement>('.dab-inner')!;
      if (reduce) return void gsap.set(inner, { opacity: 1 });
      gsap.fromTo(inner, { opacity: 0, scale: 0.2, transformOrigin: '50% 50%' }, { opacity: 1, scale: 1, duration: 0.8, ease: 'elastic.out(1, 0.45)' });
      gsap.fromTo(plateBody, { scale: 1 }, { scale: 1.025, duration: 0.12, yoyo: true, repeat: 1, transformOrigin: '50% 50%', ease: 'power2.out' });
    };

    const complete = () => {
      const r = plateRect(), c = canvas.getBoundingClientRect();
      gsap.set([count, label], { opacity: 0 });
      bell();
      done.classList.remove('hidden');
      if (mobile.matches) setTimeout(() => (window as any).__lenis ? (window as any).__lenis.scrollTo(done, { offset: -90 }) : done.scrollIntoView({ behavior: 'smooth' }), 1400);
      if (reduce) {
        gsap.set(doneText, { opacity: 1 });
      } else {
        gsap.fromTo(doneText, { opacity: 0, scale: 0.6, transformOrigin: '50% 50%' }, { opacity: 1, scale: 1, duration: 0.9, ease: 'elastic.out(1, 0.5)' });
        gsap.to(root.querySelector('.dabs'), { rotate: 360, duration: 2.4, ease: 'expo.inOut', svgOrigin: '200 200' });
        gsap.from(done, { opacity: 0, y: 30, duration: 0.9, ease: 'expo.out', delay: 0.3 });
        gsap.from(done.querySelectorAll('.station-light'), { scaleX: 0, duration: 0.6, ease: 'power3.out', stagger: 0.12, delay: 0.6 });
        const colours = tabs.map((t) => t.dataset.colour!).concat(['#f4f7fb', '#9fc3ef', '#ffffff']);
        const cx = r.left - c.left + r.width / 2, cy = r.top - c.top + r.height / 2;
        sparks?.burst(cx, cy, 140, colours);
        setTimeout(() => sparks?.burst(cx - r.width * 0.3, cy - r.height * 0.2, 60, colours), 250);
        setTimeout(() => sparks?.burst(cx + r.width * 0.3, cy - r.height * 0.1, 60, colours), 450);
      }
      status.textContent = done.textContent?.replace(/\s+/g, ' ').trim() ?? '';
    };

    const plate = (i: number, from?: { x: number; y: number }) => {
      if (plated.has(i)) return;
      plated.add(i);
      tabs[i].classList.add('is-plated');
      plop(0.8 + plated.size * 0.12);

      // centar "mrlje" u koordinatama ekrana
      const m = dabs[i].getScreenCTM();
      const target = m ? new DOMPoint(0, 0).matrixTransform(m) : { x: 0, y: 0 };

      if (reduce) {
        showDab(i);
      } else {
        // obojena kap "leti" od karte do tanjira
        const sw = tabs[i].querySelector('.chip-swatch')!.getBoundingClientRect();
        const start = from ?? { x: sw.left + sw.width / 2, y: sw.top + sw.height / 2 };
        const dot = document.createElement('div');
        dot.className = 'fly-dot';
        dot.style.background = tabs[i].dataset.colour!;
        dot.style.width = dot.style.height = '28px';
        dot.style.left = `${start.x - 14}px`;
        dot.style.top = `${start.y - 14}px`;
        document.body.append(dot);
        const dx = target.x - start.x, dy = target.y - start.y;
        const myRound = round;
        gsap.timeline({ onComplete: () => { dot.remove(); if (myRound === round) showDab(i); } })
          .to(dot, { x: dx, duration: 0.6, ease: 'power2.inOut' }, 0)
          .to(dot, { y: Math.min(dy, 0) - 80, duration: 0.3, ease: 'power2.out' }, 0)
          .to(dot, { y: dy, duration: 0.3, ease: 'power2.in' }, 0.3)
          .to(dot, { scale: 0.6, duration: 0.6 }, 0);
      }

      updateCount();
      if (plated.size === total) completeTimer = window.setTimeout(complete, reduce ? 0 : 750);
    };

    const reset = () => {
      round++;
      clearTimeout(completeTimer);
      plated.clear();
      tabs.forEach((t) => t.classList.remove('is-plated'));
      const inners = dabs.map((d) => d.querySelector('.dab-inner')!);
      gsap.killTweensOf([...inners, doneText, plateBody, root.querySelector('.dabs')]);
      gsap.set(inners, { opacity: 0, scale: 1 });
      gsap.set(root.querySelector('.dabs'), { rotate: 0, svgOrigin: '200 200' });
      gsap.set(doneText, { opacity: 0, scale: 1 });
      gsap.set([count, label], { opacity: 1 });
      document.querySelectorAll('.fly-dot').forEach((d) => d.remove());
      done.classList.add('hidden');
      updateCount();
      select(0);
      tabs[0].focus({ preventScroll: true });
    };
    resetBtn.addEventListener('click', reset);

    /* --- traka sa karticama na telefonu: sopstveni klizač (prst i strelice) --- */
    const viewport = root.querySelector<HTMLElement>('.strip-viewport')!;
    const strip = root.querySelector<HTMLElement>('.chip-strip')!;
    const prevBtn = root.querySelector<HTMLButtonElement>('.strip-prev')!;
    const nextBtn = root.querySelector<HTMLButtonElement>('.strip-next')!;
    const dots = Array.from(root.querySelectorAll<HTMLElement>('.strip-dots span'));
    const narrow = window.matchMedia('(max-width: 1023px)');
    let pos = 0;
    let dragX: number | null = null;
    let dragY = 0;
    let dragDx = 0;
    let dragging = false;
    const step = () => tabs[1].offsetLeft - tabs[0].offsetLeft;
    const maxOffset = () => Math.max(0, strip.scrollWidth - viewport.clientWidth);
    const lastPos = () => Math.ceil(maxOffset() / step() - 0.01);
    const offsetFor = (i: number) => Math.min(i * step(), maxOffset());
    const render = (extra = 0) => {
      if (!narrow.matches) { strip.style.transform = ''; return; }
      const x = Math.max(-maxOffset() - 40, Math.min(40, -offsetFor(pos) + extra));
      strip.style.transform = `translate3d(${x}px,0,0)`;
      prevBtn.disabled = pos <= 0;
      nextBtn.disabled = pos >= lastPos();
      dots.forEach((d, k) => {
        d.hidden = k > lastPos();
        const on = k === pos;
        d.classList.toggle('w-5', on); d.classList.toggle('bg-ice', on);
        d.classList.toggle('w-1.5', !on); d.classList.toggle('bg-snow/25', !on);
      });
    };
    const go = (i: number) => { pos = Math.max(0, Math.min(lastPos(), i)); render(); };
    prevBtn.addEventListener('click', () => go(pos - 1));
    nextBtn.addEventListener('click', () => go(pos + 1));
    // izabrana kartica (npr. tastaturom) uvek je vidljiva
    function showTab(i: number) {
      if (!narrow.matches) return;
      const o = offsetFor(pos);
      if (tabs[i].offsetLeft - o < 0 || tabs[i].offsetLeft + tabs[i].offsetWidth - o > viewport.clientWidth) go(Math.min(i, lastPos()));
    }
    strip.addEventListener('pointerdown', (e) => {
      if (!narrow.matches || e.pointerType === 'mouse') return;
      dragX = e.clientX; dragY = e.clientY; dragDx = 0; dragging = false;
    });
    strip.addEventListener('pointermove', (e) => {
      if (dragX === null) return;
      const dx = e.clientX - dragX, dy = e.clientY - dragY;
      if (!dragging && Math.abs(dx) > 8 && Math.abs(dx) > Math.abs(dy)) { dragging = true; strip.classList.add('is-dragging'); }
      if (dragging) { dragDx = dx; render(dx); }
    });
    const endDrag = () => {
      if (dragX === null) return;
      strip.classList.remove('is-dragging');
      if (dragging) {
        const moved = Math.round(-dragDx / step());
        const nudge = moved === 0 && Math.abs(dragDx) > 40 ? (dragDx < 0 ? 1 : -1) : moved;
        go(pos + nudge);
        // posle prevlačenja ne računaj dodir kao klik na karticu
        const block = (ev: Event) => { ev.stopPropagation(); ev.preventDefault(); };
        strip.addEventListener('click', block, { capture: true, once: true });
        setTimeout(() => strip.removeEventListener('click', block, { capture: true } as any), 50);
      }
      dragX = null; dragging = false;
    };
    strip.addEventListener('pointerup', endDrag);
    strip.addEventListener('pointercancel', endDrag);
    // dodir: touch događaji kao rezerva za WebView-ove koji ne šalju pointer događaje
    strip.addEventListener('touchstart', (e) => {
      if (!narrow.matches || dragX !== null) return;
      dragX = e.touches[0].clientX; dragY = e.touches[0].clientY; dragDx = 0; dragging = false;
    }, { passive: true });
    strip.addEventListener('touchmove', (e) => {
      if (dragX === null) return;
      const t = e.touches[0];
      const dx = t.clientX - dragX, dy = t.clientY - dragY;
      if (!dragging && Math.abs(dx) > 8 && Math.abs(dx) > Math.abs(dy)) { dragging = true; strip.classList.add('is-dragging'); }
      if (dragging) { e.preventDefault(); dragDx = dx; render(dx); }
    }, { passive: false });
    strip.addEventListener('touchend', endDrag);
    narrow.addEventListener('change', () => go(pos));
    window.addEventListener('resize', () => go(pos));
    render();

    /* --- list sa detaljima na telefonu --- */
    const sheet = root.querySelector<HTMLElement>('[data-sheet]')!;
    const backdrop = root.querySelector<HTMLElement>('.sheet-backdrop')!;
    const mobile = window.matchMedia('(max-width: 1023px)');
    let sheetTimer: number | undefined;
    let sheetOpener: HTMLElement | null = null;
    const openSheet = (delay = 0) => {
      if (!mobile.matches) return;
      clearTimeout(sheetTimer);
      sheetTimer = window.setTimeout(() => {
        sheet.classList.add('is-open');
        backdrop.classList.add('is-open');
        sheet.scrollTop = 0;
        (window as any).__lenis?.stop();
        sheet.querySelector<HTMLElement>('.sheet-close')!.focus({ preventScroll: true });
      }, delay);
    };
    const closeSheet = () => {
      clearTimeout(sheetTimer);
      if (!sheet.classList.contains('is-open')) return;
      sheet.classList.remove('is-open');
      backdrop.classList.remove('is-open');
      (window as any).__lenis?.start();
      sheetOpener?.focus({ preventScroll: true });
    };
    sheet.querySelector('.sheet-close')!.addEventListener('click', closeSheet);
    backdrop.addEventListener('click', closeSheet);
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeSheet(); });
    // prevlačenje lista nadole ga zatvara
    let sy = 0;
    sheet.addEventListener('touchstart', (e) => (sy = e.touches[0].clientY), { passive: true });
    sheet.addEventListener('touchend', (e) => { if (sheet.scrollTop <= 0 && e.changedTouches[0].clientY - sy > 80) closeSheet(); });

    /* --- klik / tastatura --- */
    let suppressClick = false;
    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => {
        if (suppressClick) return void (suppressClick = false);
        const fresh = !plated.has(i);
        select(i);
        plate(i);
        sheetOpener = tab;
        // posle poslednje kartice ostaje se na tanjiru da se vidi "Service!"
        if (plated.size < total || !fresh) openSheet(fresh && !reduce ? 750 : 0);
      });
      tab.addEventListener('keydown', (e) => {
        const n = tabs.length;
        const cols = 3;
        const map: Record<string, number> = {
          ArrowRight: (i + 1) % n,
          ArrowLeft: (i - 1 + n) % n,
          ArrowDown: (i + cols) % n,
          ArrowUp: (i - cols + n) % n,
          Home: 0,
          End: n - 1,
        };
        if (e.key in map) {
          e.preventDefault();
          select(map[e.key], true);
        }
      });
    });

    /* --- prevlačenje (samo miš/trackpad, na širokom ekranu) --- */
    if (fine && window.matchMedia('(min-width: 1024px)').matches) {
      tabs.forEach((tab, i) => {
        tab.addEventListener('pointerdown', (e) => {
          if (e.button !== 0) return;
          const sx = e.clientX, sy = e.clientY;
          let ghost: HTMLDivElement | null = null;
          let over = false;

          const move = (ev: PointerEvent) => {
            if (!ghost) {
              if (Math.hypot(ev.clientX - sx, ev.clientY - sy) < 8) return;
              ghost = document.createElement('div');
              ghost.className = 'drag-ghost';
              ghost.style.background = tab.dataset.colour!;
              document.body.append(ghost);
              tab.classList.add('is-dragging');
              select(i);
            }
            gsap.set(ghost, { x: ev.clientX - 42, y: ev.clientY - 32, rotate: gsap.utils.clamp(-18, 18, (ev.movementX || 0) * 1.5) });
            const r = plateRect();
            const cx = r.left + r.width / 2, cy = r.top + r.height / 2;
            over = Math.hypot(ev.clientX - cx, ev.clientY - cy) < r.width / 2;
            plateWrap.classList.toggle('is-over', over);
          };

          const up = (ev: PointerEvent) => {
            window.removeEventListener('pointermove', move);
            window.removeEventListener('pointerup', up);
            plateWrap.classList.remove('is-over');
            tab.classList.remove('is-dragging');
            if (!ghost) return; // običan klik — rešava ga 'click'
            suppressClick = true;
            setTimeout(() => (suppressClick = false), 0);
            const g = ghost;
            if (over) {
              g.remove();
              plate(i, { x: ev.clientX, y: ev.clientY });
            } else {
              const sw = tab.querySelector('.chip-swatch')!.getBoundingClientRect();
              gsap.to(g, { x: sw.left + sw.width / 2 - 42, y: sw.top + sw.height / 2 - 32, rotate: 0, duration: 0.5, ease: 'back.out(1.4)', onComplete: () => g.remove() });
            }
          };

          window.addEventListener('pointermove', move);
          window.addEventListener('pointerup', up);
        });
      });
    }

    updateCount();
  });
</script>
