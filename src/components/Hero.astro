---
import { Image } from 'astro:assets';
import type { Dict, Lang } from '../i18n/utils';
import { site } from '../site.config';
import portrait from '../assets/images/portrait-hero.jpg';

interface Props {
  lang: Lang;
  t: Dict;
}
const { lang, t } = Astro.props;
const h = t.hero;
---
<section class="relative grain overflow-hidden pt-24 md:pt-32 pb-16 md:pb-24 min-h-dvh flex items-center" aria-labelledby="hero-title">
  <!-- topli sjaj u pozadini -->
  <div aria-hidden="true" class="pointer-events-none absolute -top-40 right-[-10%] h-[42rem] w-[42rem] rounded-full bg-copper-deep/20 blur-[140px]"></div>

  <div class="container-x relative grid items-center gap-12 lg:grid-cols-12 lg:gap-10">
    <div class="lg:col-span-7 order-2 lg:order-1">
      <p class="eyebrow" data-reveal>{h.eyebrow}</p>

      <h1 id="hero-title" class="mt-6 text-[clamp(3.2rem,9vw,7.5rem)] text-cream" data-reveal style="--reveal-delay:80ms">
        {h.name}
        <span class="block mt-2 text-[0.42em] italic font-light text-brass">{h.nickname}</span>
      </h1>

      <p class="mt-8 text-sm md:text-base tracking-[0.18em] uppercase text-cream/90" data-reveal style="--reveal-delay:160ms">
        {h.title}
      </p>

      <div class="mt-6 h-px w-20 bg-copper" aria-hidden="true" data-reveal style="--reveal-delay:200ms"></div>

      <p class="mt-6 max-w-xl text-lg md:text-xl leading-relaxed text-muted" data-reveal style="--reveal-delay:240ms">
        {h.pitch}
      </p>

      <p class="mt-6 flex items-start gap-3 text-sm text-cream/85 max-w-xl" data-reveal style="--reveal-delay:300ms">
        <span class="relative mt-1.5 flex h-2 w-2 shrink-0" aria-hidden="true">
          <span class="absolute inline-flex h-full w-full rounded-full bg-copper opacity-60 motion-safe:animate-ping"></span>
          <span class="relative inline-flex h-2 w-2 rounded-full bg-copper"></span>
        </span>
        {h.current}
      </p>

      <div class="mt-10 flex flex-wrap gap-4" data-reveal style="--reveal-delay:360ms">
        <a href="#contact" class="btn btn-primary">{h.ctaContact}</a>
        <a href={site.cv[lang]} class="btn btn-ghost" download>
          {h.ctaCv}
          <span class="normal-case tracking-normal text-muted text-xs">({h.cvNote})</span>
        </a>
      </div>
    </div>

    <div class="lg:col-span-5 order-1 lg:order-2" data-reveal style="--reveal-delay:120ms">
      <figure class="relative mx-auto max-w-[22rem] sm:max-w-md lg:max-w-none">
        <div aria-hidden="true" class="absolute -inset-3 md:-inset-4 border border-copper/40 translate-x-3 translate-y-3 md:translate-x-5 md:translate-y-5"></div>
        <div class="relative overflow-hidden bg-ink-2">
          <Image
            src={portrait}
            alt={h.portraitAlt}
            widths={[360, 540, 720, 960]}
            sizes="(min-width: 1024px) 40vw, (min-width: 640px) 28rem, 22rem"
            loading="eager"
            fetchpriority="high"
            class="w-full h-auto aspect-[4/5] object-cover object-top grayscale-[15%] contrast-[1.02]"
          />
          <div aria-hidden="true" class="absolute inset-0 bg-gradient-to-t from-ink/70 via-transparent to-transparent"></div>
        </div>
      </figure>
    </div>
  </div>

  <a href="#numbers" class="hidden md:flex absolute bottom-8 left-1/2 -translate-x-1/2 flex-col items-center gap-3 text-[0.65rem] tracking-[0.3em] uppercase text-muted hover:text-cream transition-colors">
    {h.scroll}
    <span class="block h-10 w-px bg-gradient-to-b from-muted to-transparent" aria-hidden="true"></span>
  </a>
</section>
