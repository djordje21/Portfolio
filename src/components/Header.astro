---
import { languages, langs, localizePath, type Lang, type Dict } from '../i18n/utils';
import { site } from '../site.config';

interface Props {
  lang: Lang;
  t: Dict;
}
const { lang, t } = Astro.props;
const home = `/${lang}/`;
const links = [
  { href: `${home}#expertise`, label: t.nav.expertise },
  { href: `${home}#pre-opening`, label: t.nav.preopening },
  { href: `${home}#career`, label: t.nav.career },
  { href: `${home}#philosophy`, label: t.nav.philosophy },
  { href: `${home}#gallery`, label: t.nav.gallery },
  { href: `${home}#projects`, label: t.nav.projects },
  { href: `${home}#contact`, label: t.nav.contact },
];
const path = Astro.url.pathname;
// Aplikacije iz porodice, direktno iz menija na telefonu.
const apps = [
  { href: `${site.family.macrochef}?lang=${lang}`, label: 'MacroChef' },
  ...(site.family.showAcademyLink ? [{ href: `${site.family.academy}?lang=${lang}`, label: 'Macro Chef Academy' }] : []),
];
---
<a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-[60] focus:bg-snow focus:text-navy focus:px-4 focus:py-2">
  {t.a11y.skip}
</a>

<header
  id="site-header"
  class="fixed inset-x-0 top-0 z-50 transition-[background-color,border-color,backdrop-filter] duration-500 border-b border-transparent"
>
  <div class="container-x flex h-16 md:h-20 items-center justify-between gap-6">
    <a href={home} class="group flex items-baseline gap-3">
      <span class="font-display text-2xl text-ice" aria-hidden="true">ĐM</span>
      <span class="sr-only sm:not-sr-only text-[0.7rem] tracking-[0.22em] uppercase text-muted group-hover:text-snow transition-colors">
        {t.hero.name}
      </span>
    </a>

    <nav aria-label="Primary" class="hidden lg:block">
      <ul class="flex items-center gap-7">
        {links.map((l, i) => (
          <li>
            {i === links.length - 1 ? (
              <a href={l.href} class="border border-ice/60 px-4 py-2 text-[0.78rem] tracking-[0.12em] uppercase text-snow hover:bg-snow hover:text-navy transition-colors">
                {l.label}
              </a>
            ) : (
              <a href={l.href} class="text-[0.78rem] tracking-[0.12em] uppercase text-muted hover:text-snow transition-colors">
                {l.label}
              </a>
            )}
          </li>
        ))}
      </ul>
    </nav>

    <div class="flex items-center gap-4">
      <ul class="flex items-center text-[0.72rem] tracking-[0.14em]" aria-label={t.a11y.language}>
        {langs.map((l, i) => (
          <li class="flex items-center">
            {i > 0 && <span class="text-line px-1.5" aria-hidden="true">/</span>}
            <a
              href={localizePath(path, l)}
              hreflang={languages[l].htmlLang}
              lang={languages[l].htmlLang}
              aria-current={l === lang ? 'true' : undefined}
              class:list={[
                'py-2 px-0.5 transition-colors',
                l === lang ? 'text-ice' : 'text-muted hover:text-snow',
              ]}
            >
              {languages[l].label}<span class="sr-only"> · {languages[l].name}</span>
            </a>
          </li>
        ))}
      </ul>

      <button
        id="menu-toggle"
        type="button"
        class="lg:hidden -mr-2 p-2 text-snow"
        aria-expanded="false"
        aria-controls="mobile-menu"
        data-open-label={t.a11y.menu}
        data-close-label={t.a11y.closeMenu}
        aria-label={t.a11y.menu}
      >
        <span class="burger" aria-hidden="true"><span></span><span></span><span></span></span>
      </button>
    </div>
  </div>

  <nav id="mobile-menu" aria-label="Mobile" class="lg:hidden border-t border-b border-line bg-navy shadow-[0_30px_60px_-20px_rgba(0,0,0,0.6)]" data-open="false" inert>
    <ul class="container-x pt-4 pb-6">
      {links.slice(0, -1).map((l, i) => (
        <li class="menu-item border-b border-line/70" style={`--i:${i}`}>
          <a href={l.href} class="group flex items-baseline gap-4 py-4">
            <span class="w-6 text-[0.65rem] tabular-nums tracking-[0.15em] text-ice/70">{String(i + 1).padStart(2, '0')}</span>
            <span class="font-display text-[1.45rem] leading-none text-snow transition-colors group-hover:text-ice">{l.label}</span>
            <span aria-hidden="true" class="ml-auto text-sm text-muted transition-transform group-hover:translate-x-1 group-hover:text-ice">→</span>
          </a>
        </li>
      ))}
      <li class="menu-item pt-6" style={`--i:${links.length - 1}`}>
        <a href={links[links.length - 1].href} class="block border border-ice/60 py-3.5 text-center text-[0.78rem] tracking-[0.18em] uppercase text-snow transition-colors hover:bg-snow hover:text-navy">
          {links[links.length - 1].label}
        </a>
      </li>
    </ul>
    <div class="container-x pb-6 flex flex-wrap gap-2">
      {apps.map((a) => (
        <a href={a.href} class="border border-line px-4 py-2.5 text-[0.75rem] tracking-[0.12em] uppercase text-gold hover:border-gold transition-colors">{a.label} ↗</a>
      ))}
    </div>
  </nav>
</header>

<script>
  const header = document.getElementById('site-header')!;
  const toggle = document.getElementById('menu-toggle')!;
  const menu = document.getElementById('mobile-menu')!;

  const onScroll = () => {
    const scrolled = window.scrollY > 24;
    header.classList.toggle('bg-navy/85', scrolled);
    header.classList.toggle('backdrop-blur-md', scrolled);
    header.classList.toggle('border-line', scrolled);
  };
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  const setOpen = (open: boolean) => {
    menu.dataset.open = String(open);
    menu.toggleAttribute('inert', !open);
    toggle.setAttribute('aria-expanded', String(open));
    toggle.setAttribute('aria-label', (open ? toggle.dataset.closeLabel : toggle.dataset.openLabel) ?? '');
    if (open) header.classList.add('bg-navy/85', 'backdrop-blur-md');
    else onScroll();
  };
  toggle.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
  menu.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setOpen(false)));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
      setOpen(false);
      toggle.focus();
    }
  });
</script>

<style>
  /* Meni se spušta kao zavesa, stavke ulaze jedna za drugom */
  #mobile-menu {
    position: absolute;
    inset-inline: 0;
    top: 100%;
    clip-path: inset(0 0 100% 0);
    visibility: hidden;
    transition: clip-path 0.6s cubic-bezier(0.22, 1, 0.36, 1), visibility 0s 0.6s;
  }
  #mobile-menu[data-open='true'] {
    clip-path: inset(0 0 0 0);
    visibility: visible;
    transition: clip-path 0.6s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .menu-item {
    opacity: 0;
    transform: translateY(12px);
    transition: opacity 0.3s, transform 0.3s;
  }
  #mobile-menu[data-open='true'] .menu-item {
    opacity: 1;
    transform: none;
    transition: opacity 0.5s ease calc(0.12s + var(--i) * 0.05s), transform 0.6s cubic-bezier(0.22, 1, 0.36, 1) calc(0.12s + var(--i) * 0.05s);
  }

  /* Tri linije koje se pretvore u X */
  .burger { position: relative; display: block; width: 24px; height: 24px; }
  .burger span {
    position: absolute;
    left: 3px;
    height: 1.5px;
    border-radius: 1px;
    background: currentColor;
    transition: transform 0.45s cubic-bezier(0.22, 1, 0.36, 1), opacity 0.25s, width 0.45s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .burger span:nth-child(1) { top: 6.25px; width: 18px; }
  .burger span:nth-child(2) { top: 11.25px; width: 18px; }
  .burger span:nth-child(3) { top: 16.25px; width: 12px; }
  [aria-expanded='true'] .burger span:nth-child(1) { transform: translateY(5px) rotate(45deg); }
  [aria-expanded='true'] .burger span:nth-child(2) { opacity: 0; }
  [aria-expanded='true'] .burger span:nth-child(3) { width: 18px; transform: translateY(-5px) rotate(-45deg); }

  @media (prefers-reduced-motion: reduce) {
    #mobile-menu, #mobile-menu[data-open='true'], .menu-item, #mobile-menu[data-open='true'] .menu-item, .burger span { transition: none; }
  }
</style>
