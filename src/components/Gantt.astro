---
import type { Dict } from '../i18n/utils';
import { domainColours, type Domain } from '../data/domains';

interface Props {
  t: Dict;
  compact?: boolean;
}
const { t, compact = false } = Astro.props;
const c = t.caseStudy;

// Vremenska osa: nedelje u odnosu na otvaranje (0)
const FROM = -16;
const TO = 4;
const span = TO - FROM;
const pos = (w: number) => ((w - FROM) / span) * 100;
const ticks = [-16, -12, -8, -4, 0, 4];
const fmtWeek = (w: number) => (w > 0 ? `+${w}` : w === 0 ? '0' : `−${Math.abs(w)}`);
---
<figure class="gantt" data-gantt>
  <figcaption class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1 mb-6">
    <span class="font-display text-2xl md:text-3xl">{c.ganttTitle}</span>
    <span class="text-xs tracking-[0.18em] uppercase text-muted">
      {c.ganttAxis}
      <span class="md:hidden normal-case tracking-normal"> · <span class="inline-block h-3 w-px bg-ice align-middle"></span> {c.opening}</span>
    </span>
  </figcaption>

  <div class="relative">
    <!-- osa sa nedeljama (samo na širim ekranima je u liniji sa trakama) -->
    <div class="hidden md:grid grid-cols-[16rem_1fr] gap-6 mb-3" aria-hidden="true">
      <span></span>
      <div class="relative h-5 text-[0.7rem] tabular-nums text-muted">
        {ticks.map((w) => (
          <span class="absolute -translate-x-1/2" style={`left:${pos(w)}%`}>{w === 0 ? c.opening : fmtWeek(w)}</span>
        ))}
      </div>
    </div>

    <ol class:list={['relative', compact ? 'space-y-2.5' : 'space-y-3.5']}>
      {c.phases.map((ph) => (
        <li class="md:grid md:grid-cols-[16rem_1fr] md:gap-6 md:items-center">
          <span class:list={['block text-snow/90 mb-1.5 md:mb-0', compact ? 'text-sm' : 'text-[0.95rem]']}>
            {ph.label}
            <span class="sr-only"> ({fmtWeek(ph.start)} – {fmtWeek(ph.end)} {c.ganttAxis})</span>
          </span>
          <div class="gantt-track relative h-3 md:h-3.5 rounded-full bg-snow/[0.06]" aria-hidden="true">
            {ticks.map((w) => (
              <span class:list={['absolute inset-y-0 w-px', w === 0 ? 'bg-ice md:bg-snow/10' : 'bg-snow/10']} style={`left:${pos(w)}%`}></span>
            ))}
            <span
              class="gantt-bar absolute inset-y-0 rounded-full origin-left"
              style={`left:${pos(ph.start)}%;width:${pos(ph.end) - pos(ph.start)}%;background:${domainColours[ph.domain as Domain]}`}
            ></span>
          </div>
        </li>
      ))}
    </ol>

    <!-- linija otvaranja -->
    <div class="pointer-events-none absolute top-8 bottom-0 right-0 hidden md:block" style="left:calc(16rem + 1.5rem)" aria-hidden="true">
      <span class="absolute -top-1 bottom-0 w-px bg-ice" style={`left:${pos(0)}%`}></span>
      <span class="absolute -bottom-2 h-2 w-2 -translate-x-1/2 rounded-full bg-ice" style={`left:${pos(0)}%`}></span>
    </div>
  </div>

  {!compact && <p class="mt-6 text-xs text-muted">{c.ganttNote}</p>}
</figure>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);

  if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    document.querySelectorAll<HTMLElement>('[data-gantt]').forEach((el) => {
      const bars = el.querySelectorAll('.gantt-bar');
      gsap.set(bars, { scaleX: 0 });
      ScrollTrigger.create({
        trigger: el,
        start: 'top 80%',
        once: true,
        onEnter: () => gsap.to(bars, { scaleX: 1, duration: 1.1, ease: 'expo.out', stagger: 0.09 }),
      });
    });
  }
</script>
