---
import { languages, type Dict, type Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
  t: Dict;
}
const { lang, t } = Astro.props;
const locale = languages[lang].htmlLang;
const fmt = new Intl.NumberFormat(locale);
---
<section id="numbers" class="relative border-y border-line bg-surface" aria-label={t.numbers.label}>
  <dl class="container-x grid grid-cols-2 lg:grid-cols-4">
    {t.numbers.items.map((n, i) => (
      <div
        class:list={[
          'py-12 md:py-16 px-2 md:px-8 flex flex-col-reverse justify-end gap-3 border-line',
          i % 2 === 1 && 'border-l',
          i >= 2 && 'border-t lg:border-t-0',
          i === 2 && 'lg:border-l',
        ]}
        data-reveal
        style={`--reveal-delay:${i * 90}ms`}
      >
        <dt class="text-xs md:text-sm leading-snug text-muted max-w-[14rem]">{n.label}</dt>
        <dd class="font-display text-5xl md:text-7xl text-fg [font-variant-numeric:lining-nums_tabular-nums]">
          <span data-count={n.value} data-locale={locale}>{fmt.format(n.value)}</span><span class="text-accent">{n.suffix}</span>
        </dd>
      </div>
    ))}
  </dl>
</section>

<script>
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const els = document.querySelectorAll<HTMLElement>('[data-count]');

  const animate = (el: HTMLElement) => {
    const target = Number(el.dataset.count);
    const fmt = new Intl.NumberFormat(el.dataset.locale);
    const duration = 1800;
    const start = performance.now();
    const tick = (now: number) => {
      const p = Math.min((now - start) / duration, 1);
      const eased = 1 - Math.pow(1 - p, 4);
      el.textContent = fmt.format(Math.round(target * eased));
      if (p < 1) requestAnimationFrame(tick);
    };
    requestAnimationFrame(tick);
  };

  if (!reduce) {
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (e.isIntersecting) {
            animate(e.target as HTMLElement);
            io.unobserve(e.target);
          }
        }
      },
      { threshold: 0.6 },
    );
    els.forEach((el) => {
      el.textContent = '0';
      io.observe(el);
    });
  }
</script>
