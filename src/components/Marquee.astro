---
import type { Dict } from '../i18n/utils';

interface Props {
  t: Dict;
}
const { t } = Astro.props;
// Ponavljamo reči dovoljno puta da traka bude beskonačna
const words = [...t.marquee, ...t.marquee, ...t.marquee];
---
<div class="relative overflow-hidden border-b border-line py-8 md:py-12 select-none" aria-hidden="true">
  <div class="flex w-max whitespace-nowrap" data-marquee>
    {[0, 1].map(() => (
      <div class="flex items-center">
        {words.map((w, i) => (
          <>
            <span class:list={['font-display text-6xl md:text-8xl px-6 md:px-10', i % 2 ? 'text-outline italic' : 'text-cream/90']}>{w}</span>
            <span class="text-brass text-2xl md:text-4xl">✦</span>
          </>
        ))}
      </div>
    ))}
  </div>
</div>
