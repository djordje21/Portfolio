---
import type { Dict } from '../i18n/utils';
import { site } from '../site.config';

interface Props {
  t: Dict;
}
const { t } = Astro.props;
const year = new Date().getFullYear();
---
<footer class="border-t border-line">
  <div class="container-x py-10 flex flex-col sm:flex-row gap-4 items-start sm:items-center justify-between text-xs tracking-[0.12em] uppercase text-muted">
    <p>© {year} {site.name}. {t.footer.rights}</p>
    <a href="#top" class="hover:text-cream transition-colors">{t.footer.top} ↑</a>
  </div>
</footer>
