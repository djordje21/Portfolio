---
import '../styles/global.css';
import { getImage } from 'astro:assets';
import { languages, langs, localizePath, type Lang, defaultLang } from '../i18n/utils';
import { site } from '../site.config';
import portrait from '../assets/images/portrait-hero.jpg';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  ogAlt?: string;
}

const { lang, title, description, ogAlt = '' } = Astro.props;
const path = Astro.url.pathname;
const canonical = new URL(localizePath(path, lang), Astro.site);
const og = await getImage({ src: portrait, width: 1200, height: 1200, fit: 'cover', format: 'jpg' });
const ogUrl = new URL(og.src, Astro.site);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  alternateName: 'Đole',
  jobTitle: 'Executive Chef',
  email: `mailto:${site.email}`,
  address: { '@type': 'PostalAddress', addressLocality: 'Belgrade', addressCountry: 'RS' },
  knowsLanguage: ['sr', 'en', 'ru'],
  sameAs: [site.linkedin],
  url: canonical.href,
  image: ogUrl.href,
};
---
<!doctype html>
<html lang={languages[lang].htmlLang} class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {!site.indexable && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    {langs.map((l) => (
      <link rel="alternate" hreflang={languages[l].htmlLang} href={new URL(localizePath(path, l), Astro.site)} />
    ))}
    <link rel="alternate" hreflang="x-default" href={new URL(localizePath(path, defaultLang), Astro.site)} />

    <meta property="og:type" content="profile" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:alt" content={ogAlt} />
    <meta property="og:locale" content={languages[lang].ogLocale} />
    {langs.filter((l) => l !== lang).map((l) => <meta property="og:locale:alternate" content={languages[l].ogLocale} />)}
    <meta name="twitter:card" content="summary_large_image" />

    <meta name="theme-color" content="#0a1628" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <script is:inline>
      (function () {
        var d = document.documentElement;
        d.classList.replace('no-js', 'js');
        var seen = false;
        try { seen = !!sessionStorage.getItem('intro-seen'); } catch (e) {}
        var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (seen || reduce) d.classList.add('intro-seen');
        else d.classList.add('intro-active');
      })();
    </script>
  </head>
  <body class="min-h-dvh overflow-x-hidden">
    <slot />
    <script>
      // Fade/slide pri skrolovanju
      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (e.isIntersecting) {
              e.target.classList.add('is-visible');
              io.unobserve(e.target);
            }
          }
        },
        { rootMargin: '0px 0px -10% 0px', threshold: 0.1 },
      );
      const observeAll = () => document.querySelectorAll('[data-reveal]').forEach((el) => io.observe(el));
      // dok traje filmski uvod, animacije čekaju da se zavese otvore
      if (document.documentElement.classList.contains('intro-active') && !document.documentElement.dataset.intro) {
        document.addEventListener('intro:done', observeAll, { once: true });
      } else observeAll();
    </script>
    <script>
      import '../scripts/motion';
    </script>
  </body>
</html>
